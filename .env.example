# Copier en .env (jamais versionné) et renseigner les vraies valeurs.
# Le backend lit ce fichier à la racine du dépôt ou du dossier backend.

# Identité de l'émetteur imprimée sur les factures
INVOICE_ISSUER_NAME=Nom de l'entreprise
INVOICE_ISSUER_ADDRESS_LINE1=1 rue Exemple
INVOICE_ISSUER_ADDRESS_LINE2=
INVOICE_ISSUER_POSTAL_CODE=00000
INVOICE_ISSUER_CITY=Ville
# Facultatifs : laissés vides, ils n'apparaissent pas sur le PDF
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_EMAIL=
INVOICE_ISSUER_PHONE=
INVOICE_ISSUER_IBAN=

# Protection de l'API
INVOICE_CORS_ALLOWED_ORIGINS=http://localhost:5173
INVOICE_RATE_LIMIT_PER_MINUTE=30
# Documentation Swagger UI (désactiver hors développement)
INVOICE_SWAGGER_UI_ENABLED=true
