# Copier en deploy/.env.prod sur le serveur (jamais versionné) et renseigner les valeurs.
# Les valeurs contenant un $ (empreinte du mot de passe) doivent être entre apostrophes.

# Domaine public, pointé vers le serveur (DNS)
SITE_DOMAIN=factures.exemple.fr

# Images publiées par la CI sur ghcr.io (une version précise, jamais "latest")
BACKEND_IMAGE=ghcr.io/gomugomuno01/invoice-pdf-backend:1.0.0
FRONTEND_IMAGE=ghcr.io/gomugomuno01/invoice-pdf-frontend:1.0.0

# Accès : "restreint" (recommandé) ou "public"
ACCES=restreint
BASIC_AUTH_USER=moi
# Empreinte bcrypt : docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'mot-de-passe'
BASIC_AUTH_HASH='$2a$14$remplacer.par.l.empreinte.generee'

# Émetteur par défaut (facultatif : il se saisit aussi dans le formulaire)
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_ADDRESS_LINE1=
INVOICE_ISSUER_ADDRESS_LINE2=
INVOICE_ISSUER_POSTAL_CODE=
INVOICE_ISSUER_CITY=
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_EMAIL=
INVOICE_ISSUER_PHONE=
INVOICE_ISSUER_IBAN=

# Mentions légales du site (éditeur : vous ; hébergeur : le fournisseur du serveur)
INVOICE_SITE_EDITOR_NAME=
INVOICE_SITE_EDITOR_ADDRESS=
INVOICE_SITE_EDITOR_EMAIL=
INVOICE_SITE_PUBLICATION_DIRECTOR=
INVOICE_SITE_HOST_NAME=
INVOICE_SITE_HOST_ADDRESS=
INVOICE_SITE_HOST_CONTACT=

# Générations de PDF par minute et par adresse
INVOICE_RATE_LIMIT_PER_MINUTE=30
